{
  "name": "otools-zitext",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ZITEXT Editor as an OTools standalone plugin: the full Monaco editor UI, backed by the OTools host filesystem API instead of a Tauri Rust backend.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sync-upstream": "node scripts/sync-upstream.mjs",
    "check-upstream": "node scripts/sync-upstream.mjs --check",
    "sync-sdk": "node scripts/sync-sdk.mjs",
    "check-sdk": "node scripts/sync-sdk.mjs --check",
    "build": "node scripts/build.mjs",
    "tree": "node scripts/build.mjs --tree",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "pack": "node scripts/pack-plugin.mjs && node scripts/verify-plugin.mjs",
    "verify": "node scripts/verify-plugin.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "dompurify": "^3.4.17",
    "github-markdown-css": "^5.9.0",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.1.3",
    "monaco-editor": "^0.55.1",
    "otools-plugin-sdk": "^0.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "minimatch": "^11.0.1"
  }
}
